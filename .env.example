# =============================================================================
# Opportunity Index — environment template
# =============================================================================
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials.
#
#   cp .env.example .env.local
#
# Values below are placeholders. They are not secrets and must not be treated
# as working credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — client
# -----------------------------------------------------------------------------
# Both are exposed to the browser. That is expected: the publishable key is
# safe to ship precisely because Row Level Security restricts what it can read.
# Anonymous callers may read published rows and insert a newsletter signup,
# nothing more. See docs/DATA_MODEL.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Supabase — server only
# -----------------------------------------------------------------------------
# DANGER: this key bypasses Row Level Security entirely.
#   * Never prefix it with NEXT_PUBLIC_
#   * Never import it into a client component
#   * Never log it
# Use it only in server-side content and migration tooling.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Direct connection, for applying schema.sql and seed.sql:
#   psql "$DATABASE_URL" -f supabase/schema.sql
#   psql "$DATABASE_URL" -f supabase/seed.sql   # run from the repository root
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap, and
# Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Analytics — Google Analytics 4 (primary)
# -----------------------------------------------------------------------------
# The measurement ID is public by design; it ships in the page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only. Grants write access to the Measurement Protocol.
#   * Never prefix it with NEXT_PUBLIC_
#   * Never import it into a client component
# Note: the production MP endpoint returns 2xx even for malformed payloads, so
# development runs every event through the debug endpoint first. See
# src/lib/analytics/ga4.ts.
GA_API_SECRET=

# -----------------------------------------------------------------------------
# Analytics — Plausible (optional, behind a flag)
# -----------------------------------------------------------------------------
# Off unless PLAUSIBLE_ENABLED is exactly "true". Leave off unless you intend to
# run both providers: enabling it alongside GA4 double-counts pageviews.
PLAUSIBLE_ENABLED=false

# The site domain as registered in Plausible, e.g. opportunityindex.com.
PLAUSIBLE_SITE_ID=

# Stats API v2 only (POST https://plausible.io/api/v2/query). The Events API
# (POST https://plausible.io/api/event) takes NO token — do not send it one.
PLAUSIBLE_STATS_API_KEY=

# -----------------------------------------------------------------------------
# Email — Kit (formerly ConvertKit), v4 API
# -----------------------------------------------------------------------------
# Server-only. Unset in development: signups are stored locally and the form
# still confirms, so the flow stays testable without credentials.
KIT_API_KEY=

# Optional. When set, subscribers are also added to this form, which is what
# drives the sequence and double opt-in confirmation.
KIT_FORM_ID=

# -----------------------------------------------------------------------------
# Affiliate tracking
# -----------------------------------------------------------------------------
# Salt for the pseudonymous visitor digest recorded against a click.
# Raw IP addresses are never stored; the IP is digest input only. Without this
# salt no visitor hash is recorded at all, because a bare hash of an IP is
# trivially reversible.
CLICK_HASH_SALT=

# -----------------------------------------------------------------------------
# Affiliate networks (not yet integrated)
# -----------------------------------------------------------------------------
# Both adapters are interface-only. Each stays disabled — its ingest route
# answers 501 — until a real secret is set AND the adapter is completed against
# the network's official payload specification. See
# src/lib/monetization/adapters/.
IMPACT_WEBHOOK_SECRET=
REFERSION_WEBHOOK_SECRET=
