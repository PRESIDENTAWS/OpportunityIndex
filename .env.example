# =============================================================================
# Opportunity Index — environment template
# =============================================================================
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials.
#
#   cp .env.example .env.local
#
# Values below are placeholders. They are not secrets and must not be treated
# as working credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — client
# -----------------------------------------------------------------------------
# Both are exposed to the browser. That is expected: the publishable key is
# safe to ship precisely because Row Level Security restricts what it can read.
# Anonymous callers may read published rows and insert a newsletter signup,
# nothing more. See docs/DATA_MODEL.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Supabase — server only
# -----------------------------------------------------------------------------
# DANGER: this key bypasses Row Level Security entirely.
#   * Never prefix it with NEXT_PUBLIC_
#   * Never import it into a client component
#   * Never log it
# Use it only in server-side content and migration tooling.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Direct connection, for applying schema.sql and seed.sql:
#   psql "$DATABASE_URL" -f supabase/schema.sql
#   psql "$DATABASE_URL" -f supabase/seed.sql   # run from the repository root
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap, and
# Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Newsletter (optional)
# -----------------------------------------------------------------------------
# Unset in development: the signup form confirms locally instead of sending.
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Unset in development so local traffic is never recorded.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
